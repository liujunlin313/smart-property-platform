<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartproperty.platform.community.mapper.AdminCommunityMapper">
    <select id="selectActiveCommunities" resultType="com.smartproperty.platform.community.vo.CommunityListVO">
        SELECT community_id, community_code, community_name, address_line AS address, status
        FROM community
        WHERE status = 'ACTIVE'
        <if test="!scope.global">
            <choose><when test="scope.communityIds != null and scope.communityIds.size() > 0">
                AND community_id IN <foreach collection="scope.communityIds" item="id" open="(" close=")" separator=",">#{id}</foreach>
            </when><otherwise>AND 1 = 0</otherwise></choose>
        </if>
        ORDER BY community_code
    </select>
</mapper>
