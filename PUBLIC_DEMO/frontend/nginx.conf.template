log_format public_demo_json escape=json '{'
    '"timestamp":"$time_iso8601",'
    '"request_id":"$request_id",'
    '"load_test_id":"$http_x_load_test_id",'
    '"remote_addr":"$remote_addr",'
    '"x_forwarded_for_raw":"$http_x_forwarded_for",'
    '"cf_connecting_ip_raw":"$http_cf_connecting_ip",'
    '"method":"$request_method",'
    '"request_uri":"$request_uri",'
    '"status":$status,'
    '"request_bytes":$request_length,'
    '"response_bytes":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_response_time":"$upstream_response_time",'
    '"upstream_status":"$upstream_status",'
    '"user_agent":"$http_user_agent",'
    '"referer":"$http_referer"'
'}';

server {
    listen 80;
    server_name _;
    charset utf-8;
    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/nginx/access/access.jsonl public_demo_json;
    error_log /var/log/nginx/nginx/error/error.log warn;
    client_max_body_size 16m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\\n";
    }

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Trace-Id $request_id;
        proxy_set_header X-Load-Test-ID $http_x_load_test_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
