# Copy this file to .env.docker and replace every <CHANGE_ME> value locally.
# Do not commit .env.docker and do not reuse a personal password.

# Isolated host-only debug ports. The original Windows services remain on
# 3306, 6379, 9000, and 9001; Redis deliberately has no host port here.
PUBLIC_MYSQL_HOST_PORT=33307
PUBLIC_MINIO_API_HOST_PORT=19000
PUBLIC_MINIO_CONSOLE_HOST_PORT=19001
PUBLIC_BACKEND_HOST_PORT=18081
PUBLIC_WEB_HOST_PORT=18080
# Keep the Stage 2 browser entry loopback-only. Change this manually to 0.0.0.0 only for a LAN test.
WEB_BIND_ADDRESS=127.0.0.1

# Windows-visible, bind-mounted runtime logs. Keep this outside source, backups and named data volumes.
PUBLIC_DEMO_LOG_ROOT=./logs
PUBLIC_DEMO_LOG_RUN=run-YYYYMMDD-HHMMSS-host-boot

# Optional local-only credentials consumed by scripts/loadtest. Leave blank in examples.
LOAD_TEST_USERNAME=
LOAD_TEST_PASSWORD=
# Updated by scripts/docker/deploy-service.ps1 for each manual application deployment.
PUBLIC_DEMO_DEPLOYMENT_ID=D-UNTRACKED

# MySQL 8.0.43 creates this account on its first empty-volume startup.
MYSQL_APP_USER=smart_property_app
MYSQL_APP_PASSWORD=<CHANGE_ME>
MYSQL_ROOT_PASSWORD=<CHANGE_ME>

# These are credentials for the NEW, independent Docker MinIO target.
# They are not the source-backup credentials and must not be printed.
MINIO_ROOT_USER=<CHANGE_ME>
MINIO_ROOT_PASSWORD=<CHANGE_ME>

# Docker backend runtime. Generate a stable Base64 string that decodes to at least 32 random bytes.
APP_JWT_SECRET_BASE64=<CHANGE_ME>
# Flyway is deliberately disabled for the first Docker startup because Stage 1 restored an existing V1-V10 schema.
APP_FLYWAY_ENABLED=false

# Existing AMap credentials used by the restored application. Do not put real values in this tracked example.
AMAP_WEB_SERVICE_KEY=<CHANGE_ME>
AMAP_WEB_SERVICE_PRIVATE_KEY=<CHANGE_ME>
VITE_AMAP_JS_KEY=<CHANGE_ME>
VITE_AMAP_JS_SECURITY_CODE=<CHANGE_ME>

# Required bind root for backend and Nginx logs; choose a local writable directory.
PUBLIC_DEMO_ACTIVE_RUN_LOG_ROOT=./logs/run-local
APP_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
