<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartproperty.platform.asset.mapper.AssetAuditMapper">
    <insert id="insert">
        INSERT INTO asset_change_audit
            (entity_type,entity_id,operation,before_data,after_data,reason,changed_by_account_id)
        VALUES (#{entityType},#{entityId},#{operation},#{beforeData},#{afterData},#{reason},#{accountId})
    </insert>
</mapper>
